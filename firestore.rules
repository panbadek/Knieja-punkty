rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signed() { return request.auth != null; }
    function hasProfile() { return signed() && exists(/databases/$(db)/documents/users/$(request.auth.uid)); }
    function me() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    // Administrator = konto kadry z przełącznikiem admin == true (rola 'admin' dla zgodności wstecz)
    function admin() { return hasProfile() && ((me().rola == 'kadra' && me().get('admin', false) == true) || me().rola == 'admin'); }
    function kadra() { return hasProfile() && me().rola in ['kadra', 'admin']; }
    function zastepowy() { return hasProfile() && me().rola == 'zastepowy'; }
    function szeregowy() { return hasProfile() && me().rola == 'szeregowy'; }
    function mojZastep() { return me().zastep in ['Lisy', 'Łosie', 'Żubry', 'Rysie', 'Niedźwiedzie', 'Gronostaje']; }
    function alarm(id) { return get(/databases/$(db)/documents/alarmy/$(id)).data; }

    match /config/{d} { allow read: if true; allow write: if kadra(); }

    // Konta: tylko administrator tworzy, zmienia i usuwa
    match /users/{uid} {
      allow read: if signed() && (request.auth.uid == uid || kadra());
      allow create: if admin();
      // własnej funkcji i uprawnień administratora nie można sobie zmienić — robi to inny administrator
      allow update: if (admin() && (uid != request.auth.uid ||
          (request.resource.data.rola == resource.data.rola && request.resource.data.get('admin', false) == resource.data.get('admin', false))))
        // kadra: tylko funkcja i zastęp innych osób (nie administratorów)
        || (kadra() && uid != request.auth.uid && resource.data.get('admin', false) != true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rola', 'zastep'])
          && request.resource.data.rola in ['szeregowy', 'zastepowy', 'kadra']);
      allow delete: if admin() && uid != request.auth.uid;
    }
    match /loginy/{login} {
      allow get: if true;
      allow list, write: if admin();
    }
    match /sekrety/{uid} {
      allow read: if admin();
      allow write: if admin() || (signed() && request.auth.uid == uid);   // własne hasło po samodzielnej zmianie
    }

    match /zbiorkiZastepu/{id} {
      allow read: if true;
      allow create: if kadra() ||
        (zastepowy() && request.resource.data.zastep == me().zastep && request.resource.data.status == 'oczekuje');
      allow update: if kadra() ||
        (zastepowy() && resource.data.zastep == me().zastep && resource.data.status == 'oczekuje'
          && request.resource.data.status == 'oczekuje' && request.resource.data.zastep == me().zastep);
      allow delete: if kadra() ||
        (zastepowy() && resource.data.zastep == me().zastep && resource.data.status == 'oczekuje');
    }

    match /akcje/{id}  { allow read: if true; allow write: if kadra(); }
    match /korekty/{id} { allow read: if true; allow write: if kadra(); }
    match /alarmy/{id} { allow read: if true; allow write: if kadra(); }

    match /meldunki/{id} {
      allow read: if true;
      allow create: if (szeregowy() || zastepowy()) && mojZastep()
        && id == request.resource.data.alarmId + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.zastep == me().zastep
        && request.resource.data.status == 'oczekuje'
        && request.resource.data.czas == request.time
        && request.time.toMillis() >= alarm(request.resource.data.alarmId).startMs
        && request.time.toMillis() < alarm(request.resource.data.alarmId).startMs + 86400000;
      allow update: if kadra();
      allow delete: if kadra() || (signed() && resource.data.uid == request.auth.uid && resource.data.status == 'oczekuje');
    }

    match /zdjecia/{id} {
      allow read: if kadra() || (signed() && resource.data.uid == request.auth.uid);
      allow create, update: if signed() && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.alarmId + '_' + request.auth.uid;
      allow delete: if kadra() || (signed() && resource.data.uid == request.auth.uid);
    }
  }
}
